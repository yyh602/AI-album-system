RewriteEngine On

# 確保 PHP 檔案可以正常訪問
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# 允許直接訪問 PHP 檔案
<Files "*.php">
    Require all granted
</Files>

# 設置正確的 MIME 類型
AddType application/json .json
AddType text/css .css
AddType application/javascript .js
